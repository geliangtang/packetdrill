--tolerance_usecs=100000
`../../common/defaults.sh`

// TCP_MD5SIG getsockopt is not supported by MPTCP sockets and will never be.
0.0   socket(..., SOCK_STREAM, IPPROTO_MPTCP) = 3
+0.0  setsockopt(3, SOL_TCP, TCP_MD5SIG, [1], 4)   = -1 EINVAL (Invalid argument)
+0.0  getsockopt(3, SOL_TCP, TCP_MD5SIG, [0], [4]) = -1 EOPNOTSUPP (Operation not supported)
